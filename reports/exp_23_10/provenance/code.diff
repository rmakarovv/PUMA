@@ -0,0 +1,44 @@
+"""Three behavioral tests for offline rescoring; CUDA sanity is separate."""
+
+import unittest
+
+import torch
+from torch import nn
+
+from scripts.rescore_sudoku_checkpoint import PrecisionModel, validate_checkpoint
+
+
+class RescorePrecisionContract(unittest.TestCase):
+    def test_precision_modes_preserve_or_override_the_outer_autocast(self):
+        torch.manual_seed(42)
+        model = nn.Linear(4, 3).eval()
+        inputs = torch.randn(2, 4)
+        reference = model(inputs)
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            legacy = PrecisionModel(model, "legacy_bf16")(inputs)
+            softmax_only = PrecisionModel(model, "bf16_fp32_softmax")(inputs)
+            full = PrecisionModel(model, "full_fp32")(inputs)
+            self.assertTrue(torch.is_autocast_enabled("cpu"))
+        self.assertEqual(legacy.dtype, torch.bfloat16)
+        self.assertEqual(softmax_only.dtype, torch.float32)
+        self.assertTrue(torch.equal(softmax_only, legacy.float()))
+        self.assertEqual(full.dtype, torch.float32)
+        torch.testing.assert_close(full, reference, rtol=0.0, atol=0.0)
+
+    def test_fp32_softmax_distinguishes_confidences_rounded_to_one_in_bf16(self):
+        logits = torch.tensor([[[8.0, 0.0, -8.0], [9.0, 0.0, -8.0]]], dtype=torch.bfloat16)
+        identity = nn.Identity()
+        legacy = PrecisionModel(identity, "legacy_bf16")(logits).softmax(dim=-1).amax(dim=-1)
+        fixed = PrecisionModel(identity, "bf16_fp32_softmax")(logits).softmax(dim=-1).amax(dim=-1)
+        self.assertTrue(torch.equal(legacy, torch.ones_like(legacy)))
+        self.assertTrue((fixed < 1.0).all().item())
+        self.assertGreater(fixed[0, 1].item(), fixed[0, 0].item())
+
+    def test_rejects_non_ema_checkpoint_before_loading_model_weights(self):
+        checkpoint = {"is_ema_snapshot": False, "global_step": 53570}
+        with self.assertRaisesRegex(ValueError, "Expected an EMA checkpoint"):
+            validate_checkpoint(checkpoint, expected_step=53570, expected_seed=1000)
+
+
+if __name__ == "__main__":
+    unittest.main()
