@@ -0,0 +1,61 @@
+#!/bin/bash
+# Submit from the repository root after data preprocessing and the two-GPU smoke run.
+# EXP_DIR=runs/sudoku_C_20261022 sbatch scripts/run_sudoku_C_array.sbatch
+# Two array items cover five seeds within the account's two-job/four-GPU quota.
+# Every seed still uses exactly the A/F two-GPU training configuration.
+#SBATCH --job-name=puma_sudoku_C
+#SBATCH --partition=cscc-gpu-p
+#SBATCH --qos=cscc-gpu-qos
+#SBATCH --account=cscc-users
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gres=gpu:2
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=96G
+#SBATCH --time=08:00:00
+#SBATCH --array=0-1
+#SBATCH --exclude=gpu-02,gpu-05,gpu-51,gpu-52,gpu-54,gpu-55
+#SBATCH --output=runs/logs/%x_%A_%a.out
+
+set -euo pipefail
+cd "${SLURM_SUBMIT_DIR:?submit from the repository root}"
+export EXP_DIR=${EXP_DIR:-runs/sudoku_C_20261022}
+export PY=${PY:-.venv/bin/python}
+task=${SLURM_ARRAY_TASK_ID:?this launcher requires a job array}
+case "$task" in
+    0) seeds=(1000 3000 5000) ;;
+    1) seeds=(2000 4000) ;;
+    *) echo "invalid array task index: $task" >&2; exit 2 ;;
+esac
+if [[ -n "${EXTRA:-}" || "${RUN_TIMEOUT:-0}" != 0 ]]; then
+    echo "full study forbids smoke overrides and per-run timeouts" >&2
+    exit 2
+fi
+for cache in data/sudoku_new/train_mdm.npy data/sudoku_new/test_mdm.npy; do
+    test -s "$cache" || { echo "missing preprocessed cache: $cache" >&2; exit 1; }
+done
+"$PY" -m unittest discover -s tests -p test_condition_c.py -v
+"$PY" -m unittest discover -s tests -p test_rescore_precision.py -v
+status=0
+for seed in "${seeds[@]}"; do
+    if ! bash scripts/run_sudoku_AE.sbatch "C:$seed"; then
+        status=1
+        continue
+    fi
+    out="$EXP_DIR/C/seed$seed"
+    rescore_status=0
+    for mode in legacy_bf16 bf16_fp32_softmax full_fp32; do
+        if ! "$PY" -m torch.distributed.run --standalone --nproc_per_node=2 \
+            scripts/rescore_sudoku_checkpoint.py \
+            --checkpoint "$out/ema_step=53570.pt" --mode "$mode" \
+            --expected-step 53570 --expected-seed "$seed" \
+            --output "$out/rescore_$mode.json" > "$out/rescore_$mode.log" 2>&1; then
+            status=1
+            rescore_status=1
+        fi
+    done
+    if [[ "$rescore_status" == 0 ]]; then
+        touch "$out/RESCORE_DONE"
+    fi
+done
+exit "$status"
