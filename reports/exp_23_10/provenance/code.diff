@@ -0,0 +1,80 @@
+#!/bin/bash
+# Compare precision modes on two saved snapshots without touching training.
+# Submit only after both checkpoints exist.
+#SBATCH --job-name=puma_C_precision_check
+#SBATCH --partition=long,cscc-gpu-p
+#SBATCH --qos=gpu-debug-qos
+#SBATCH --account=cscc-users
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gres=gpu:2
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=32G
+#SBATCH --time=00:20:00
+#SBATCH --exclude=gpu-02,gpu-05,gpu-51,gpu-52,gpu-54,gpu-55
+#SBATCH --output=runs/logs/%x_%j.out
+
+set -euo pipefail
+cd "${SLURM_SUBMIT_DIR:?submit from the repository root}"
+PY=${PY:-.venv/bin/python}
+EXP_DIR=${EXP_DIR:-runs/sudoku_C_20261022}
+export SEED=${SEED:-1000}
+export DIAGNOSTIC_DIR="runs/precision_diagnostic_C_${SLURM_JOB_ID}"
+export TQDM_MININTERVAL=60 PYTHONUNBUFFERED=1
+export DIAGNOSTIC_RUN="$EXP_DIR/C/seed$SEED"
+mkdir -p "$DIAGNOSTIC_DIR"
+for step in 10000 30000; do
+    test -s "$DIAGNOSTIC_RUN/ema_step=$step.pt"
+done
+echo "job=$SLURM_JOB_ID node=$(hostname) start=$(date -Is) seed=$SEED"
+for step in 10000 30000; do
+    mkdir -p "$DIAGNOSTIC_DIR/step$step"
+    for mode in legacy_bf16 bf16_fp32_softmax full_fp32; do
+        echo "[$(date -Is)] step=$step mode=$mode"
+        "$PY" -m torch.distributed.run --standalone --nproc_per_node=2 \
+            scripts/rescore_sudoku_checkpoint.py \
+            --checkpoint "$DIAGNOSTIC_RUN/ema_step=$step.pt" \
+            --mode "$mode" --expected-step "$step" --expected-seed "$SEED" \
+            --expected-world-size 2 --expected-test-count 999 \
+            --output "$DIAGNOSTIC_DIR/step$step/rescore_$mode.json" \
+            > "$DIAGNOSTIC_DIR/step$step/$mode.log" 2>&1
+    done
+done
+"$PY" - <<'PY'
+import json
+import os
+from pathlib import Path
+
+root = Path(os.environ["DIAGNOSTIC_DIR"])
+run = Path(os.environ["DIAGNOSTIC_RUN"])
+raw = (run / "metrics.jsonl").read_bytes()
+if raw and not raw.endswith(b"\n"):
+    raw = raw.rsplit(b"\n", 1)[0] if b"\n" in raw else b""
+records = [json.loads(line) for line in raw.splitlines()]
+rows = []
+for step in (10000, 30000):
+    original = [r for r in records if r.get("step") == step and "val_acc" in r]
+    if len(original) != 1:
+        raise RuntimeError(f"Expected one training evaluation at step {step}")
+    row = {"step": step, "training_legacy_bf16": original[0]["val_acc"]["top_k_unmasking_1"]}
+    hashes = set()
+    prefixes = set()
+    for mode in ("legacy_bf16", "bf16_fp32_softmax", "full_fp32"):
+        result = json.loads((root / f"step{step}" / f"rescore_{mode}.json").read_text())
+        if result["step"] != step or result["mode"] != mode:
+            raise RuntimeError("Diagnostic output metadata does not match request")
+        hashes.add(result["checkpoint_sha256"])
+        prefixes.add(result["evaluation"]["data_prefix_sha256"])
+        row[mode] = result["metrics"]["top_k_unmasking_1"]
+    if len(hashes) != 1 or len(prefixes) != 1:
+        raise RuntimeError("Precision modes did not use the same checkpoint and data")
+    row["legacy_reproduced_exactly"] = row["legacy_bf16"] == row["training_legacy_bf16"]
+    rows.append(row)
+summary = {"seed": int(os.environ["SEED"]),
+           "rows": rows, "source_run": str(run), "diagnostic_dir": str(root)}
+(root / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+print(json.dumps(summary, indent=2))
+if not all(row["legacy_reproduced_exactly"] for row in rows):
+    raise RuntimeError("Legacy evaluation did not reproduce; inspect batch/kernel context before attribution")
+PY
+date -Is > "$DIAGNOSTIC_DIR/DONE"
