+#!/bin/bash
+# Submit from the repository root after the complete five-seed training array:
+# EXP_DIR=runs/sudoku_C_20261022 sbatch --dependency=afterany:335458 scripts/rescore_sudoku_C_curve.sbatch
+# Scores the five saved intermediate EMA checkpoints; the array owns the final score.
+# Corrected curves have six checkpoint observations, not 1,000-update resolution.
+#SBATCH --job-name=puma_C_fp32_curve
+#SBATCH --partition=cscc-gpu-p
+#SBATCH --qos=cscc-gpu-qos
+#SBATCH --account=cscc-users
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gres=gpu:2
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=32G
+#SBATCH --time=02:00:00
+#SBATCH --exclude=gpu-02,gpu-05,gpu-51,gpu-52,gpu-54,gpu-55
+#SBATCH --output=runs/logs/%x_%j.out
+
+set -uo pipefail
+cd "${SLURM_SUBMIT_DIR:?submit from the repository root}" || exit 1
+PY=${PY:-.venv/bin/python}
+EXP_DIR=${EXP_DIR:-runs/sudoku_C_20261022}
+export TQDM_MININTERVAL=60 PYTHONUNBUFFERED=1
+
+if ! command -v "$PY" >/dev/null 2>&1; then
+    echo "Python interpreter is unavailable: $PY" >&2
+    exit 1
+fi
+echo "job=${SLURM_JOB_ID:-manual} node=$(hostname) start=$(date -Is) experiment=$EXP_DIR"
+echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
+if ! "$PY" - <<'PY'
+import torch
+
+count = torch.cuda.device_count()
+if count != 2:
+    raise RuntimeError(f"Expected two allocated GPUs, found {count}")
+for index in range(count):
+    matrix = torch.randn(1024, 1024, device=f"cuda:{index}", dtype=torch.float32)
+    value = (matrix @ matrix).sum().item()
+    print(f"preflight cuda:{index} {torch.cuda.get_device_name(index)} sum={value:.6e}")
+PY
+then
+    echo "CUDA preflight failed" >&2
+    exit 1
+fi
+
+validate_result() {
+    "$PY" - "$@" <<'PY'
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+
+import numpy as np
+
+
+def digest_file(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+result_path, checkpoint_path = (Path(value) for value in sys.argv[1:3])
+seed, step = (int(value) for value in sys.argv[3:5])
+try:
+    record = json.loads(result_path.read_text())
+    require(isinstance(record, dict), "result must be a JSON object")
+    for key, expected in {
+        "schema_version": 1,
+        "type": "checkpoint_rescore",
+        "condition": "C",
+        "seed": seed,
+        "step": step,
+        "mode": "full_fp32",
+    }.items():
+        require(record.get(key) == expected, f"unexpected {key}: {record.get(key)!r}")
+    require(record.get("is_ema_snapshot") is True, "result is not from EMA weights")
+    evaluation = record["evaluation"]
+    require(evaluation["world_size"] == 2, "world size must be two")
+    require(evaluation["test_count"] == 999, "test count must be 999")
+    require(evaluation["per_rank_batch_size"] == 16, "evaluation batch size must be 16 per rank")
+    require(evaluation["accuracy_definition"] == "valid_completed_grid_preserving_givens", "wrong accuracy definition")
+    sampling = evaluation["sampling"]
+    require(sampling["temperature"] == 0.0, "decoding must be greedy")
+    require("top_k" in sampling["confidence"] and 1 in sampling["unmasking_num"], "missing primary decoder")
+    score = record["metrics"]["top_k_unmasking_1"]
+    require(isinstance(score, (int, float)) and not isinstance(score, bool), "accuracy must be numeric")
+    require(math.isfinite(score) and 0.0 <= score <= 1.0, "invalid accuracy")
+    require(abs(score * 999 - round(score * 999)) < 1e-7, "accuracy is inconsistent with 999 puzzles")
+    precision = record["precision"]
+    require(precision["model_forward"] == "float32" and precision["softmax"] == "float32", "wrong evaluation precision")
+    require(precision["allow_tf32_matmul"] is False, "TF32 must be disabled")
+    require(precision["float32_matmul_precision"] == "highest", "FP32 matmul precision must be highest")
+    require(checkpoint_path.is_file(), f"missing checkpoint: {checkpoint_path}")
+    require(Path(record["checkpoint"]).resolve() == checkpoint_path.resolve(), "checkpoint path differs")
+    require(record["checkpoint_sha256"] == digest_file(checkpoint_path), "checkpoint SHA256 differs")
+    for source in (
+        "sampling.py", "eval/sudoku_eval.py", "model/transformer.py",
+        "scripts/rescore_sudoku_checkpoint.py",
+    ):
+        require(record["source_sha256"][source] == digest_file(Path(source)), f"source SHA256 differs: {source}")
+    raw = np.load(evaluation["data_file"], mmap_mode="r", allow_pickle=False)
+    require(raw.ndim == 2 and raw.shape[1] == 162, "invalid Sudoku cache shape")
+    require(int(len(raw) * float(evaluation["validation_ratio"])) == 999, "validation subset differs")
+    prefix_digest = hashlib.sha256(raw[:999].tobytes(order="C")).hexdigest()
+    require(evaluation["data_prefix_sha256"] == prefix_digest, "evaluation data prefix SHA256 differs")
+except (OSError, ValueError, TypeError, KeyError, IndexError) as error:
+    print(f"INVALID {result_path}: {error}", file=sys.stderr)
+    sys.exit(1)
+print(f"VALID C seed={seed} step={step} full_fp32 accuracy={score:.9f}")
+PY
+}
+
+status=0
+for seed in 1000 2000 3000 4000 5000; do
+    out="$EXP_DIR/C/seed$seed"
+    if [[ ! -d "$out" ]]; then
+        echo "Missing run directory: $out" >&2
+        status=1
+        continue
+    fi
+    if ! mkdir -p "$out/rescore_curve_logs"; then
+        status=1
+        continue
+    fi
+    if ! log_dir=$(mktemp -d "$out/rescore_curve_logs/job-${SLURM_JOB_ID:-manual}.XXXXXX"); then
+        echo "Cannot create curve-rescoring log directory for seed $seed" >&2
+        status=1
+        continue
+    fi
+    if [[ -e "$out/CURVE_RESCORE_DONE" ]]; then
+        if ! mv "$out/CURVE_RESCORE_DONE" "$log_dir/prior_CURVE_RESCORE_DONE"; then
+            echo "Cannot archive existing curve marker for seed $seed" >&2
+            status=1
+            continue
+        fi
+    fi
+    seed_status=0
+    for step in 10000 20000 30000 40000 50000; do
+        checkpoint="$out/ema_step=$step.pt"
+        result="$out/rescore_full_fp32_step$step.json"
+        checkpoint_log="$log_dir/step$step.log"
+        if [[ ! -s "$checkpoint" ]]; then
+            echo "Missing checkpoint: $checkpoint" | tee "$checkpoint_log" >&2
+            seed_status=1
+            status=1
+            continue
+        fi
+        if [[ -s "$result" ]] && validate_result "$result" "$checkpoint" "$seed" "$step" > "$checkpoint_log" 2>&1; then
+            echo "Skip validated full_fp32 score: seed=$seed step=$step"
+            continue
+        fi
+        if [[ -f "$result" ]]; then
+            if ! cp -p "$result" "$log_dir/step$step.previous.json"; then
+                echo "Cannot preserve invalid previous score: $result" >&2
+                seed_status=1
+                status=1
+                continue
+            fi
+        fi
+        echo "[$(date -Is)] Rescore C seed=$seed step=$step full_fp32 -> $result"
+        if ! "$PY" -m torch.distributed.run --standalone --nproc_per_node=2 \
+            scripts/rescore_sudoku_checkpoint.py \
+            --checkpoint "$checkpoint" --mode full_fp32 \
+            --expected-step "$step" --expected-seed "$seed" \
+            --expected-world-size 2 --expected-test-count 999 \
+            --output "$result" >> "$checkpoint_log" 2>&1; then
+            echo "Rescoring failed for seed=$seed step=$step; log=$checkpoint_log" >&2
+            seed_status=1
+            status=1
+            continue
+        fi
+        if ! validate_result "$result" "$checkpoint" "$seed" "$step" >> "$checkpoint_log" 2>&1; then
+            echo "Output validation failed for seed=$seed step=$step; log=$checkpoint_log" >&2
+            seed_status=1
+            status=1
+        fi
+    done
+
+    # The training array produced the final result; never replace it here.
+    if ! validate_result "$out/rescore_full_fp32.json" "$out/ema_step=53570.pt" "$seed" 53570 \
+        > "$log_dir/final53570_validation.log" 2>&1; then
+        echo "Final full_fp32 score is missing or invalid for seed=$seed; log=$log_dir/final53570_validation.log" >&2
+        seed_status=1
+        status=1
+    fi
+    if [[ "$seed_status" == 0 ]]; then
+        if printf 'job=%s\nmode=full_fp32\nsteps=10000,20000,30000,40000,50000,53570\ncompleted=%s\n' \
+            "${SLURM_JOB_ID:-manual}" "$(date -Is)" > "$log_dir/CURVE_RESCORE_DONE" \
+            && mv "$log_dir/CURVE_RESCORE_DONE" "$out/CURVE_RESCORE_DONE"; then
+            echo "Validated all six full_fp32 checkpoints for seed=$seed"
+        else
+            echo "Cannot write curve completion marker for seed=$seed" >&2
+            status=1
+        fi
+    fi
+done
+echo "end=$(date -Is) exit=$status"
+exit "$status"
