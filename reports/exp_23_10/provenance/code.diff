+#!/bin/bash
+# A short end-to-end check on a separate data subset and output directory.
+#SBATCH --job-name=puma_C_smoke
+#SBATCH --partition=long,cscc-gpu-p
+#SBATCH --qos=gpu-debug-qos
+#SBATCH --account=cscc-users
+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --gres=gpu:2
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=32G
+#SBATCH --time=00:20:00
+#SBATCH --exclude=gpu-02,gpu-05,gpu-51,gpu-52,gpu-54,gpu-55
+#SBATCH --output=runs/logs/%x_%j.out
+
+set -euo pipefail
+cd "${SLURM_SUBMIT_DIR:?submit from the repository root}"
+export PY=${PY:-.venv/bin/python}
+export EXP_DIR="runs/smoke_C_${SLURM_JOB_ID}"
+"$PY" -m unittest discover -s tests -p test_condition_c.py -v
+"$PY" - <<'PY'
+from pathlib import Path
+import numpy as np
+source = Path("data/sudoku_new")
+destination = Path("data/sudoku_c_smoke")
+destination.mkdir(parents=True, exist_ok=True)
+for filename, count in (("train_mdm.npy", 4096), ("test_mdm.npy", 999)):
+    data = np.load(source / filename, mmap_mode="r")
+    assert data.ndim == 2 and data.shape[1] == 162
+    np.save(destination / filename, data[:count])
+PY
+export EXTRA="data.data_dir=data/sudoku_c_smoke validation.val_dir=data/sudoku_c_smoke validation.ratio=0.02 training.num_epochs=1 training.warmup_steps=10 training.logging_steps=1"
+export RUN_TIMEOUT=600
+bash scripts/run_sudoku_AE.sbatch C:1000
+"$PY" - <<'PY'
+import json
+import math
+import os
+from pathlib import Path
+run = Path(os.environ["EXP_DIR"]) / "C" / "seed1000"
+records = [json.loads(line) for line in (run / "metrics.jsonl").read_text().splitlines()]
+training = [record for record in records if "loss" in record]
+evaluations = [record for record in records if "val_acc" in record]
+assert len(training) == 61, len(training)
+assert all(math.isfinite(record["loss"]) for record in training)
+assert len(evaluations) == 1 and evaluations[0]["step"] == 61
+assert len(evaluations[0]["val_acc"]) == 6
+assert (run / "ema_step=61.pt").is_file()
+assert (run / "DONE").is_file()
+print("C two-GPU smoke passed: 61 finite-loss updates, six decoders, EMA checkpoint.")
+PY
