+++ b/scripts/status_sudoku_c.py
@@ -0,0 +1,50 @@
+"""Print a compact, read-only status snapshot for the five condition C runs."""
+
+import argparse
+import datetime
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("experiment", type=Path)
+    args = parser.parse_args()
+    rows = []
+    for seed in (1000, 2000, 3000, 4000, 5000):
+        directory = args.experiment / "C" / f"seed{seed}"
+        row = {"seed": seed, "started": directory.exists(), "done": (directory / "DONE").exists()}
+        path = directory / "metrics.jsonl"
+        if path.exists():
+            records = []
+            lines = path.read_text().splitlines()
+            for index, line in enumerate(lines):
+                try:
+                    records.append(json.loads(line))
+                except json.JSONDecodeError:
+                    if index != len(lines) - 1:
+                        raise
+            training = [record for record in records if "loss" in record]
+            evaluations = [record for record in records if "val_acc" in record]
+            if records:
+                row["step"] = records[-1]["step"]
+                row["train_time_s"] = records[-1].get("train_time_s")
+            if training:
+                row["loss"] = training[-1]["loss"]
+            if evaluations:
+                last = evaluations[-1]
+                row["evaluation_step"] = last["step"]
+                row["accuracy"] = last["val_acc"]["top_k_unmasking_1"]
+                row["val_loss"] = last["val_loss"]
+        info = directory / "run_info.txt"
+        if info.exists():
+            for line in info.read_text().splitlines():
+                if line.startswith("slurm_job=") or line.startswith("end="):
+                    row.setdefault("run_info", []).append(line)
+        row["rescores"] = sorted(path.name for path in directory.glob("rescore_*.json"))
+        rows.append(row)
+    print(json.dumps({"utc": datetime.datetime.now(datetime.timezone.utc).isoformat(), "runs": rows}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_condition_c.py b/tests/test_condition_c.py
new file mode 100644
index 0000000..1a359e7
--- /dev/null
+++ b/tests/test_condition_c.py
@@ -0,0 +1,166 @@
+"""Behavioral contract for condition C; run with unittest and PyTorch only."""
+
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from progressive import PhasedMasking
+
+
+class CountingExamples:
+    """A deterministic stream of unique examples, with observable consumption."""
+
+    def __init__(self, length=81, given_count=None):
+        self.length = length
+        self.given_count = given_count
+        self.draws = 0
+
+    def __iter__(self):
+        for index in range(128):
+            labels = (torch.arange(self.length, dtype=torch.long) + index) % 9
+            if self.length >= 3:
+                labels[:3] = torch.tensor(
+                    [(index // 81) % 9, (index // 9) % 9, index % 9]
+                )
+            givens = self.given_count
+            if givens is None:
+                givens = 20 + index % 10
+            prompt_mask = torch.arange(self.length) < givens
+            self.draws += 1
+            yield {"labels": labels, "prompt_mask": prompt_mask}
+
+
+def make_pool(loader, **overrides):
+    settings = {
+        "train_loader": loader,
+        "batch_size": 8,
+        "mask_id": 10,
+        "K": 20,
+        "device": torch.device("cpu"),
+        "L": 81,
+        "reference_length": 81,
+        "mode": "standard",
+        "prompt_only_reset": True,
+        "mask_schedule": [81, 61, 41, 21],
+        "random_tie_break": True,
+        "mask_construction": "independent",
+    }
+    settings.update(overrides)
+    return PhasedMasking(**settings)
+
+
+class ConditionCContract(unittest.TestCase):
+    def test_reuses_examples_and_matches_ef_schedule_without_using_logits(self):
+        """C keeps E/F counts, staggering and draws, independently of predictions."""
+        pools = []
+        loaders = []
+        for construction, reveal_score in (
+            ("independent", "confidence"),
+            ("independent", "gt_margin"),
+            ("nested", "confidence"),
+            ("nested", "gt_margin"),
+        ):
+            torch.manual_seed(2509)
+            loader = CountingExamples()
+            pools.append(
+                make_pool(
+                    loader,
+                    mask_construction=construction,
+                    reveal_score=reveal_score,
+                )
+            )
+            loaders.append(loader)
+
+        logits = torch.linspace(-4.0, 4.0, 8 * 81 * 11).reshape(8, 81, 11)
+        predictions = logits.log_softmax(dim=-1)
+        different_predictions = (-logits.flip(1)).log_softmax(dim=-1)
+        saw_remasking = False
+        for update in range(9):
+            c = pools[0]
+            stages = c.state["stage"]
+            counts = (c.current_batch() == c.mask_id).sum(dim=1)
+            expected_counts = torch.tensor(
+                [
+                    int(length) - round((1 - [81, 61, 41, 21][int(stage)] / 81) * int(length))
+                    for length, stage in zip(c.state["L_eff"], stages)
+                ]
+            )
+            self.assertTrue(torch.equal(counts, expected_counts))
+            self.assertTrue(torch.equal(torch.bincount(stages, minlength=4), torch.full((4,), 2)))
+            self.assertTrue(torch.equal(c.current_batch(), pools[1].current_batch()))
+            visible = c.current_batch() != c.mask_id
+            self.assertTrue(torch.equal(c.current_batch()[visible], c.x0[visible]))
+            self.assertTrue(visible[c.state["prompt_mask"]].all().item())
+
+            for pool, loader in zip(pools[1:], loaders[1:]):
+                self.assertTrue(torch.equal(c.x0, pool.x0))
+                self.assertTrue(torch.equal(stages, pool.state["stage"]))
+                self.assertTrue(torch.equal(counts, (pool.current_batch() == pool.mask_id).sum(dim=1)))
+                self.assertEqual(loaders[0].draws, loader.draws)
+
+            if update == 8:
+                break
+            previous_x0 = c.x0.clone()
+            previous_visible = visible.clone()
+            wraps = stages == 3
+            for index, pool in enumerate(pools):
+                torch.manual_seed(900 + update)
+                pool.update_with_logits(different_predictions if index == 1 else predictions)
+
+            self.assertTrue(torch.equal(c.x0[~wraps], previous_x0[~wraps]))
+            self.assertTrue((c.x0[wraps] != previous_x0[wraps]).any(dim=1).all().item())
+            self.assertTrue((c.current_batch()[wraps][~c.state["prompt_mask"][wraps]] == c.mask_id).all().item())
+            remasked = previous_visible & (c.current_batch() == c.mask_id)
+            saw_remasking |= remasked[~wraps].any().item()
+
+        self.assertTrue(saw_remasking, "independent states must permit previously visible cells to be hidden")
+
+    def test_rounding_boundary_resamples_even_when_mask_count_does_not_change(self):
+        """A small target retains masks and resamples across equal rounded counts."""
+        torch.manual_seed(7)
+        loader = CountingExamples(length=4, given_count=2)
+        pool = make_pool(
+            loader,
+            batch_size=1,
+            L=4,
+            reference_length=4,
+            mask_schedule=[4, 3, 2, 1],
+        )
+        predictions = torch.zeros(1, 4, 11).log_softmax(dim=-1)
+        original_example = pool.x0.clone()
+        self.assertEqual((pool.current_batch() == pool.mask_id).sum().item(), 2)
+        pool.update_with_logits(predictions)
+        self.assertEqual((pool.current_batch() == pool.mask_id).sum().item(), 2)
+        pool.update_with_logits(predictions)
+        before = pool.current_batch().clone()
+        self.assertEqual((before == pool.mask_id).sum().item(), 1)
+
+        # Force selection of the other target, while giving clues larger scores.
+        scores = torch.where(before == pool.mask_id, 0.9, 0.1)
+        scores[pool.state["prompt_mask"]] = 100.0
+        with patch("progressive.torch.rand", return_value=scores):
+            pool.update_with_logits(predictions)
+
+        self.assertEqual((pool.current_batch() == pool.mask_id).sum().item(), 1)
+        self.assertTrue(((before != pool.mask_id) & (pool.current_batch() == pool.mask_id)).any().item())
+        self.assertTrue(torch.equal(pool.x0, original_example))
+        givens = pool.state["prompt_mask"]
+        self.assertTrue(torch.equal(pool.current_batch()[givens], pool.x0[givens]))
+        self.assertEqual(loader.draws, 1)
+
+        pool.update_with_logits(predictions)
+        self.assertEqual(loader.draws, 2)
+        self.assertEqual(pool.state["stage"].item(), 0)
+        self.assertEqual((pool.current_batch() == pool.mask_id).sum().item(), 2)
+
+    def test_rejects_independent_construction_without_fixed_schedule(self):
+        """Configuration errors fail before consuming training examples."""
+        loader = CountingExamples()
+        with self.assertRaisesRegex(ValueError, "requires a fixed mask_schedule"):
+            make_pool(loader, mask_schedule=None)
+        self.assertEqual(loader.draws, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
